# Copy to .env and fill in. Never commit .env (it is in .gitignore).
# Then: chmod 600 .env   so only you can read the keys.
# Load it into your shell with:  set -a; . ./.env; set +a

# From @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=replace-with-your-bot-token
# The number of the chat the bot should talk to (README, Setup step 1). Only taps from this chat are accepted.
TELEGRAM_CHAT_ID=replace-with-your-chat-id
# Shared with the Gmail watcher (its API_KEY Script property). At least 16 characters.
JAA_API_KEY=replace-with-a-long-random-key
# Telegram repeats this with every button tap. At least 16 characters, letters, digits, _ and - only.
TELEGRAM_WEBHOOK_SECRET=replace-with-another-long-random-key

# Optional, these are the defaults.
JAA_CONFIG=config.json
JAA_STATE_FILE=state.json
JAA_HOST=127.0.0.1
JAA_PORT=8080

# Only needed if you switch the optional AI steps on (llm.enabled in config.json).
# ANTHROPIC_API_KEY=replace-with-your-anthropic-key
